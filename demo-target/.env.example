DEMO_TARGET_PORT=5050

# Target AI Provider Failover Order (comma-separated list of: gemini, groq, xai, openrouter)
# Falls back to SEMANTIC_EVALUATOR_ORDER or 'gemini,groq,openrouter' if omitted.
TARGET_AI_PROVIDER_ORDER=gemini,groq,openrouter
TARGET_TIMEOUT_MS=20000

# Target-specific AI credentials (optional: defaults to server/.env if omitted)
# Primary: Gemini
TARGET_GEMINI_API_KEY=
TARGET_GEMINI_MODEL=gemini-2.5-flash

# Secondary: Groq
TARGET_GROQ_API_KEY=
TARGET_GROQ_MODEL=llama-3.3-70b-versatile

# Alternative Secondary: xAI Grok
TARGET_XAI_API_KEY=
TARGET_XAI_MODEL=grok-2-latest

# Tertiary: OpenRouter
TARGET_OPENROUTER_API_KEY=
TARGET_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
