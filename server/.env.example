# Port for the Express server (set to 5000 to avoid conflicting with Next.js client on 3000)
PORT=5000

# ==============================================================================
# Multi-Provider Semantic Evaluator Configuration (Phase 8.3)
# ==============================================================================
# Primary Evaluator: Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Secondary Evaluator: Groq (https://console.groq.com/)
# Optional: Omit or leave blank to disable Groq failover.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative Evaluator: xAI Grok (https://console.x.ai/)
# Optional: Omit or leave blank to disable xAI failover.
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Tertiary Evaluator: OpenRouter (https://openrouter.ai/)
# Optional: Omit or leave blank to disable OpenRouter failover.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Provider Failover Order (comma-separated list of: gemini, groq, xai, openrouter)
SEMANTIC_EVALUATOR_ORDER=gemini,groq,openrouter

# Per-Provider Timeout in milliseconds (between 1000ms and 60000ms, default 20000ms)
SEMANTIC_EVALUATOR_TIMEOUT_MS=20000

# ==============================================================================
# Demo Target AI Provider Failover Configuration (Phase 8.4)
# ==============================================================================
# Target AI Provider Failover Order (gemini, groq, xai, openrouter)
# Falls back to SEMANTIC_EVALUATOR_ORDER if omitted.
TARGET_AI_PROVIDER_ORDER=gemini,groq,openrouter
TARGET_TIMEOUT_MS=20000

# Optional Target-Specific AI Overrides (defaults to the Evaluator keys above if omitted)
TARGET_GEMINI_API_KEY=
TARGET_GEMINI_MODEL=gemini-2.5-flash
TARGET_GROQ_API_KEY=
TARGET_GROQ_MODEL=llama-3.3-70b-versatile
TARGET_XAI_API_KEY=
TARGET_XAI_MODEL=grok-2-latest
TARGET_OPENROUTER_API_KEY=
TARGET_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ==============================================================================
# Network & SSRF Defenses
# ==============================================================================
# Allow testing local target endpoints (127.0.0.1 / localhost) in dev/test environments.
# Defaults to false in production for strict SSRF defense.
ALLOW_LOCAL_TARGETS=false
